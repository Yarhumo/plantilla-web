---
// Páginas sencillas (privacidad, términos…): se crean en Pages CMS → "Páginas".
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const paginas = await getCollection('paginas', ({ data }) => data.publicar);
  return paginas.map((pagina) => ({ params: { slug: pagina.id }, props: { pagina } }));
}
const { pagina } = Astro.props;
const { Content } = await render(pagina);
---
<Base titulo={pagina.data.titulo} descripcion={pagina.data.descripcion}>
  <article class="seccion contenedor estrecho prosa">
    <h1>{pagina.data.titulo}</h1>
    <Content />
  </article>
</Base>
